+
+        slot = _ChatSlot("project-agent")
+        slot.agent = "aidlc"
+        slot.project = str(self._project(tmp_path / "project"))
+        elsewhere = tmp_path / "gateway-cwd"
+        elsewhere.mkdir()
+        monkeypatch.chdir(elsewhere)
+        assert agent_discovery.cached_project_agent_names(slot.project) is None
+        if warm_cache:
