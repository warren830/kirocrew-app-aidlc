+class TestEagerSpawnProjectBindings:
+    """Speculative sessions resolve the same project agents as real turns."""
+
+    @pytest.fixture
+    def cfg(self, monkeypatch, tmp_path):
+        from kiro_crew import agent_discovery
+        from kiro_crew.config import loader
+
+        expected_source = os.environ.get("KIROCREW_EAGER_TEST_SOURCE")
+        if expected_source:
+            assert Path(chat_runner.__file__).resolve() == Path(expected_source).resolve()
+        package_root = Path(chat_runner.__file__).resolve().parents[1]
+        assert Path(loader.__file__).resolve().parents[1] == package_root
+        assert chat_runner.resolve_agent_bindings is loader.resolve_agent_bindings
+        monkeypatch.setattr(chat_runner, "_EAGER_SPAWN_DEBOUNCE_SECS", 0)
+        monkeypatch.setattr(chat_runner, "_armed_prefetches", {})
+        monkeypatch.setattr(agent_discovery, "_PROJECT_NAMES_CACHE", {})
+        monkeypatch.setattr(loader, "_MATERIALIZED_AGENTS_READY", True)
+        monkeypatch.setattr(loader, "_MATERIALIZED_AGENTS", frozenset())
+        cfg = loader.KiroCrewConfig(
+            agents={"default": loader.KiroCrewAgentConfig(kiro_agent="kirocrew")},
+            default_agent="default",
+            workspaces={"default": loader.WorkspaceConfig(dir=str(tmp_path / "workspace"))},
+            memory_stores={"default": loader.MemoryStoreConfig()},
+        )
+        monkeypatch.setattr(chat_runner.KiroCrewConfig, "load", lambda: cfg)
+        if hasattr(chat_runner, "_default_session_model"):
+            # Model fallback is unrelated to binding resolution and may read
+            # user agent files in runtimes that precompute it before spawning.
+            monkeypatch.setattr(chat_runner, "_default_session_model", lambda *_args: "")
+        return cfg
+
+    @staticmethod
+    def _project(root):
+        agents = root / ".kiro" / "agents"
+        agents.mkdir(parents=True, exist_ok=True)
+        (agents / "workflow.json").write_text(json.dumps({"name": "aidlc"}))
+        return root
+
+    @staticmethod
+    async def _spawn(slot, allow_resume):
+        state = _mock_state(slot)
+        state.sessions.get_or_create.return_value = (MagicMock(), True, allow_resume)
+        try:
+            await _eager_spawn(state, slot, allow_resume=allow_resume)
+            state.sessions.get_or_create.assert_awaited_once()
+            key = state.sessions.get_or_create.await_args.args[0]
+            state.sessions.release.assert_called_once_with(key)
+            kwargs = state.sessions.get_or_create.await_args.kwargs
+            assert kwargs["cwd"] == (slot.project or None)
+            assert kwargs["speculative"] is True
+            assert kwargs["speculative_resume"] is allow_resume
+            return kwargs
+        finally:
+            ttl = getattr(slot, "_prefetch_ttl_task", None)
+            if ttl is not None:
+                ttl.cancel()
+                with pytest.raises(asyncio.CancelledError):
+                    await ttl
+
+    @pytest.mark.asyncio
