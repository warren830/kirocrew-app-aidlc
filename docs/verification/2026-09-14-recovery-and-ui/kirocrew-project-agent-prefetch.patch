+    @pytest.mark.asyncio
+    @pytest.mark.skipif(
+        not hasattr(chat_runner, "_recover_app_agent_binding"),
+        reason="this source version predates app-agent prefetch recovery",
+    )
+    @pytest.mark.parametrize("allow_resume", [False, True])
+    @pytest.mark.parametrize("recovery_stage", ["rescan", "register"])
+    async def test_app_recovery_retains_project_scope(
+        self, cfg, tmp_path, monkeypatch, allow_resume, recovery_stage
+    ):
+        from kiro_crew import agent_discovery
+        from kiro_crew.apps import bridges, manager
+
+        slot = _ChatSlot("app-project-agent")
+        slot.agent = "aidlc"
+        slot._app = "aidlc-studio"
+        project = tmp_path / "project"
+        project.mkdir()
+        slot.project = str(project)
+        elsewhere = tmp_path / "gateway-cwd"
+        elsewhere.mkdir()
+        monkeypatch.chdir(elsewhere)
+
+        def materialize(*_args):
+            self._project(project)
+            # Both registration and snapshot refresh run off the event loop.
+            # Populate only this temporary project's index for the real resolver.
+            agent_discovery.project_agent_names(slot.project)
+
+        refresh = MagicMock(side_effect=materialize if recovery_stage == "rescan" else None)
+        register = MagicMock(side_effect=materialize)
+        recovery = AsyncMock(wraps=chat_runner._recover_app_agent_binding)
+        monkeypatch.setattr(chat_runner, "refresh_materialized_agents", refresh)
+        monkeypatch.setattr(chat_runner, "_recover_app_agent_binding", recovery)
+        monkeypatch.setattr(bridges, "register_app", register)
+        monkeypatch.setattr(manager, "is_app_enabled", lambda _app: True)
+        monkeypatch.setattr(manager, "app_lifecycle_lock", lambda _app: asyncio.Lock())
+
+        kwargs = await self._spawn(slot, allow_resume)
+        assert kwargs["agent"] == "aidlc"
+        refresh.assert_called_once_with()
+        if recovery_stage == "rescan":
+            recovery.assert_not_awaited()
+            register.assert_not_called()
+        else:
+            recovery.assert_awaited_once_with(cfg, slot, project=slot.project)
+            register.assert_called_once_with(slot._app)
+
