{
  "name": "aidlc-studio-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI-DLC Studio dashboard UI for KiroCrew (host provides React, lucide-react and @kirocrew/app-sdk at runtime via the import map).",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
