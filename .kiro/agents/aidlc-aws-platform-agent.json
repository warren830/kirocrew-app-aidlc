      "deniedCommands": [
        "([^\\s]*/)?rm( [^\\s]+)* -[A-Za-z]*[rR][A-Za-z]*( .*)?",
        "([^\\s]*/)?rm( [^\\s]+)* --recursive( .*)?",
        "([^\\s]*/)?git( -[^\\s]+( (\"[^\"]*\"|'[^']*'|[^\\s]+))?)* push( .*)?"
      ]
    },
    "fs_write": {
      "allowedPaths": [
        "aidlc/spaces/**"
      ]
    }
  },
  "resources": [
    "file://.kiro/agents/aidlc-aws-platform-agent.md",
    "file://.kiro/knowledge/aidlc-aws-platform-agent/*.md",
    "file://.kiro/knowledge/aidlc-shared/*.md",
    "file://aidlc/spaces/default/memory/**/*.md"
  ],
  "hooks": {
    "preToolUse": [
      {
        "matcher": "execute_bash",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro state-transition-guard aidlc-aws-platform-agent",
        "timeout_ms": 1800000
      },
      {
        "matcher": "fs_write",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro review-freeze",
        "timeout_ms": 1800000
      },
      {
        "matcher": "execute_bash",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro review-freeze",
        "timeout_ms": 1800000
      },
      {
        "matcher": "fs_write",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro plan-approval-guard",
        "timeout_ms": 1800000
      },
      {
        "matcher": "execute_bash",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro plan-approval-guard",
        "timeout_ms": 1800000
      }
    ],
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro audit-and-sensors",
        "timeout_ms": 3600000
      }
    ]
  }
}
