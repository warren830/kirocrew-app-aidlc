{
  "name": "aidlc-aws-platform-agent",
  "description": "AI-DLC AWS Platform Agent - delegation target for ensemble stages (AWS service selection, infrastructure, platform perspective).",
  "prompt": "file://aidlc-aws-platform-agent.md",
  "includeMcpJson": true,
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "thinking",
    "@context7",
    "@aws-mcp",
    "@aws-pricing",
    "@aws-iac",
    "@aws-serverless"
  ],
  "allowedTools": [
    "fs_read",
    "thinking"
  ],
  "toolsSettings": {
