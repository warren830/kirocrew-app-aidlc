    "file://.kiro/skills/aidlc/SKILL.md",
    "file://.kiro/skills/aidlc/question-rendering.md",
    "file://.kiro/skills/aidlc/composer.md",
    "file://.kiro/steering/aidlc-onboarding.md",
    "file://aidlc/active-memory/**/*.md",
    "file://AGENTS.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro session-start; exit $LASTEXITCODE",
        "timeout_ms": 1800000
      }
    ],
    "userPromptSubmit": [
      {
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro verb-intercept; exit $LASTEXITCODE",
        "timeout_ms": 1800000
      }
    ],
    "preToolUse": [
      {
        "matcher": "execute_bash",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro state-transition-guard; exit $LASTEXITCODE",
        "timeout_ms": 1800000
      },
      {
        "matcher": "execute_bash",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro guard-tool-call; exit $LASTEXITCODE",
        "timeout_ms": 1800000
      },
      {
        "matcher": "fs_write",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro review-freeze; exit $LASTEXITCODE",
        "timeout_ms": 1800000
      },
      {
        "matcher": "execute_bash",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro review-freeze; exit $LASTEXITCODE",
        "timeout_ms": 1800000
      },
      {
        "matcher": "subagent",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro deliver-stage-rules; exit $LASTEXITCODE",
        "timeout_ms": 1800000
      },
      {
        "matcher": "subagent",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro plan-approval-guard; exit $LASTEXITCODE",
        "timeout_ms": 1800000
      },
      {
        "matcher": "fs_write",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro plan-approval-guard; exit $LASTEXITCODE",
        "timeout_ms": 1800000
      },
      {
        "matcher": "execute_bash",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro plan-approval-guard; exit $LASTEXITCODE",
        "timeout_ms": 1800000
      }
    ],
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro audit-and-sensors; exit $LASTEXITCODE",
        "timeout_ms": 3600000
      },
      {
        "matcher": "execute_bash",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro rebuild-stage-graph; exit $LASTEXITCODE",
        "timeout_ms": 1800000
      },
      {
        "matcher": "todo_list",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro sync-workflow-state; exit $LASTEXITCODE",
        "timeout_ms": 1800000
      },
      {
        "matcher": "subagent",
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro log-subagent; exit $LASTEXITCODE",
        "timeout_ms": 1800000
      }
    ],
    "stop": [
      {
        "command": "bun .kiro/tools/aidlc.ts engine adapter kiro continue-workflow; exit $LASTEXITCODE",
        "timeout_ms": 3600000
      }
    ]
  }
